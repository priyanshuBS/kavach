# Copy this file to .env and fill in the values.

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=

# Telegram bot for the family alert
# 1. In Telegram, message @BotFather -> /newbot -> copy the token here
# 2. The family member opens the bot and sends "hi"
# 3. Run: npm run telegram:chatid  -> copy the number into TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Name shown in the alert, e.g. "Papa" or "Dadi"
PROTECTED_PERSON_NAME=Papa

# ---- optional ----
PORT=4000
# Set to false to use keyword rules only (no LLM)
USE_LLM=true
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Leave empty for auto-detect, or force "hi" (Hindi) / "en" (English)
WHISPER_LANGUAGE=
